FROM node:18-alpine

# 安裝必要的系統依賴
RUN apk add --no-cache \
    wget \
    python3 \
    make \
    g++ \
    sqlite-dev \
    musl-dev

# 設定工作目錄
WORKDIR /app

# 複製 package.json 和 package-lock.json
COPY package*.json ./

# 安裝所有依賴（包括開發依賴）
RUN npm install

# 建立資料庫目錄
RUN mkdir -p /app/data

# 暴露端口
EXPOSE 3001

# 設定環境變數
ENV NODE_ENV=development
ENV PORT=3001

# 啟動開發伺服器
CMD ["npm", "run", "dev"]
